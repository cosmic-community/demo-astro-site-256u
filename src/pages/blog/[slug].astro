---
export interface Props {
  post: any; // TODO: Define proper type
}

// src/pages/blog/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getPosts, getMetafieldValue } from '../../../lib/cosmic';
import type { Post } from '../../../types';
import { marked } from 'marked';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;

const imageUrl = post.metadata?.featured_image?.imgix_url;
const author = getMetafieldValue(post.metadata?.author);
const seoDescription = getMetafieldValue(post.metadata?.seo_description);
const publishedAt = post.metadata?.published_at || post.created_at;
const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const contentMarkdown = post.metadata?.content || post.content || '';
const contentHtml = contentMarkdown ? (marked.parse(contentMarkdown) as string) : '';
---

<Layout
  title={`${post.title} — Demo Astro Site`}
  description={seoDescription || post.title}
  image={imageUrl}
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/blog" class="text-sm font-medium text-amber-700 hover:underline mb-8 inline-block">
      &larr; Back to Blog
    </a>

    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-display font-bold text-stone-900 mb-4 leading-tight">
        {post.title}
      </h1>
      {(author || formattedDate) && (
        <div class="flex items-center gap-3 text-sm text-stone-500">
          {author && <span class="font-medium text-stone-700">{author}</span>}
          {author && formattedDate && <span>&bull;</span>}
          {formattedDate && <time datetime={publishedAt}>{formattedDate}</time>}
        </div>
      )}
    </header>

    {imageUrl && (
      <div class="aspect-[16/9] rounded-2xl overflow-hidden mb-10 bg-stone-100">
        <img
          src={`${imageUrl}?w=1600&h=900&fit=crop&auto=format,compress`}
          alt={post.title}
          width="1600"
          height="900"
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="prose-custom" set:html={contentHtml} />
  </article>
</Layout>