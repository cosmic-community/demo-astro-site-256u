---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../../lib/cosmic';

const posts = await getPosts();
---

<Layout
  title="Blog — Demo Astro Site"
  description="Browse all blog posts from Demo Astro Site."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-display font-bold text-stone-900 mb-4">The Blog</h1>
      <p class="text-stone-600 max-w-2xl mx-auto">Thoughts, stories, and updates.</p>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-stone-500 text-center py-12">No posts published yet. Check back soon.</p>
    )}
  </section>
</Layout>