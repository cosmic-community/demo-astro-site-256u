---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../../lib/cosmic';

const posts = await getPosts();
const latestPosts = posts.slice(0, 6);
---

<Layout
  title="Demo Astro Site — Creative Portfolio & Blog"
  description="A creative portfolio and blog showcasing stories, ideas, and work — built with Astro and powered by Cosmic."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-amber-50 to-stone-50 border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-6 py-24 text-center">
      <p class="uppercase tracking-widest text-xs text-amber-700 font-semibold mb-4">Welcome to</p>
      <h1 class="text-5xl md:text-6xl font-display font-bold text-stone-900 mb-6">Demo Astro Site</h1>
      <p class="text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
        A creative portfolio and blog showcasing stories, ideas, and work — built with Astro and powered by Cosmic.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <a
          href="/blog"
          class="inline-flex items-center px-6 py-3 rounded-full bg-stone-900 text-white font-medium hover:bg-stone-700 transition-colors"
        >
          Read the Blog
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-10">
      <h2 class="text-3xl font-display font-bold text-stone-900">Latest Posts</h2>
      <a href="/blog" class="text-sm font-medium text-amber-700 hover:underline">
        View all &rarr;
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-stone-500 text-center py-12">No posts published yet. Check back soon.</p>
    )}
  </section>
</Layout>